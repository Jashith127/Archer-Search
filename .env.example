# Copy to .env and fill in. .env is git-ignored.

# Server (defaults shown)
# ARCHER_PORT=4747
# ARCHER_PUBLIC_HOST=archer.localhost

# Local SearXNG: used server-side for suggestions, and as the results page for now
# ARCHER_SEARXNG_URL=http://127.0.0.1:8888
# ARCHER_RESULTS_URL=http://localhost:8888/search?q={q}

# Contact info (email or URL) sent in Archer's User-Agent to Wikipedia/Wikidata,
# as Wikimedia's bot policy requires. Requests without it get HTTP 403.
# ARCHER_CONTACT=you@example.com

# Place used for "weather" / "time" with no place named
# ARCHER_HOME_LOCATION=Bengaluru

# API keys for later build steps
# DEEPSEEK_API_KEY=
# TMDB_API_KEY=
# BRAVE_API_KEY=
