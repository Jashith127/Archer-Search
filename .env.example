# Copy to .env and fill in. .env is git-ignored.
# The companion app (tray → Open Archer, or /app) edits this same file and keeps its comments.

# Server (defaults shown)
# ARCHER_PORT=4747
# ARCHER_PUBLIC_HOST=archer.localhost

# Search provider: searxng, duckduckgo (no key), google or brave
# ARCHER_SEARCH_PROVIDER=duckduckgo
# Show DuckDuckGo's results when the provider fails
# ARCHER_SEARCH_FALLBACK=true
# Suggestions: auto (follow the provider), duckduckgo, google, searxng or off
# ARCHER_SUGGEST_PROVIDER=auto
# ARCHER_SUGGEST_TIMEOUT=1.5
# SafeSearch: 0 off, 1 moderate, 2 strict (unset keeps the provider's default)
# ARCHER_SAFESEARCH=
# Results language hint, e.g. en-IN or all (unset keeps the provider's default)
# ARCHER_SEARCH_LANGUAGE=

# SearXNG: results, autocomplete and bang searches when it is the provider
# ARCHER_SEARXNG_URL=http://127.0.0.1:8888
# ARCHER_RESULTS_URL=http://localhost:8888/search?q={q}
# Docker container to start with Archer
# ARCHER_SEARXNG_CONTAINER=

# Google: serper (serper.dev key) or cse (existing Programmable Search key; ends 1 Jan 2027)
# ARCHER_GOOGLE_BACKEND=serper
# ARCHER_SERPER_API_KEY=
# ARCHER_GOOGLE_API_KEY=
# ARCHER_GOOGLE_CX=
# Brave Search API subscription token
# ARCHER_BRAVE_API_KEY=

# Contact info (email or URL) sent in Archer's User-Agent to Wikipedia/Wikidata,
# as Wikimedia's bot policy requires. Requests without it get HTTP 403.
# ARCHER_CONTACT=you@example.com

# Defaults used when a search names no place, country or currency
# ARCHER_HOME_LOCATION=Bengaluru
# ARCHER_HOME_COUNTRY=IN
# ARCHER_HOME_CURRENCY=inr

# AI (optional; Classic search needs no key)
# Provider: deepseek (recommended), openai, anthropic, ollama, openrouter or custom
# ARCHER_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# ARCHER_OPENAI_API_KEY=
# ARCHER_ANTHROPIC_API_KEY=
# ARCHER_OPENROUTER_API_KEY=
# Key for a custom OpenAI-compatible server (optional)
# ARCHER_AI_API_KEY=
# Empty model and address use the provider's own (custom needs both)
# ARCHER_AI_MODEL=
# ARCHER_AI_BASE_URL=
# Ollama's context window in tokens
# ARCHER_OLLAMA_CONTEXT=16384
# Tool planning rounds: 1 by default; ordinary explanations skip paid planning entirely.
# ARCHER_AI_PLANNING_ROUNDS=1
# Final research answer ceiling, including JSON formatting.
# ARCHER_AI_ANSWER_TOKENS=5000
# Hard token cap per UTC day, across all browser sessions. Interrupted calls retain reservations.
# ARCHER_AI_DAILY_TOKENS=500000
# Optional USD pricing overrides (per million tokens). Known models are priced automatically.
# ARCHER_AI_INPUT_PRICE=
# ARCHER_AI_OUTPUT_PRICE=
# ARCHER_AI_RUN_USD=0.10
# ARCHER_AI_DAILY_USD=1.00

# History and personalization, kept in data/history.sqlite3 on this computer
# ARCHER_HISTORY=true
# Days to keep (0 = until you clear it)
# ARCHER_HISTORY_DAYS=365
# Rank by meaning and by the sites you open, recall pages found before, past searches first in suggestions
# ARCHER_PERSONALIZE=true
# Matching: potion-base-8M (30 MB, default), potion-retrieval-32M, ollama, or lexical (no download)
# ARCHER_SEMANTIC_MODEL=potion-base-8M
# ARCHER_OLLAMA_EMBED_MODEL=nomic-embed-text

# Startup: none (tray), app or search, after Windows sign-in
# ARCHER_STARTUP_OPEN=none
# ARCHER_STARTUP_DELAY=0
# ARCHER_STARTUP_NOTIFY=false

# Optional card keys
# TMDB_API_KEY=
