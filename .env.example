# Copy to .env and fill in. .env is git-ignored.
# Archer Settings (tray → Settings, or /settings) edits this same file and keeps its comments.

# Server (defaults shown)
# ARCHER_PORT=4747
# ARCHER_PUBLIC_HOST=archer.localhost

# Local SearXNG: supplies search results and autocomplete; handles bang searches
# ARCHER_SEARXNG_URL=http://127.0.0.1:8888
# ARCHER_RESULTS_URL=http://localhost:8888/search?q={q}
# ARCHER_SUGGEST_TIMEOUT=1.5
# SafeSearch: 0 off, 1 moderate, 2 strict (unset keeps SearXNG's default)
# ARCHER_SAFESEARCH=
# Results language hint, e.g. en-IN or all (unset keeps SearXNG's default)
# ARCHER_SEARCH_LANGUAGE=

# Contact info (email or URL) sent in Archer's User-Agent to Wikipedia/Wikidata,
# as Wikimedia's bot policy requires. Requests without it get HTTP 403.
# ARCHER_CONTACT=you@example.com

# Place used for "weather" / "time" with no place named
# ARCHER_HOME_LOCATION=Bengaluru

# AI search (optional; Classic needs no key)
# DEEPSEEK_API_KEY=
# ARCHER_AI_MODEL=deepseek-flash
# ARCHER_AI_BASE_URL=https://api.deepseek.com
# Tool planning rounds: 1 by default; ordinary explanations skip paid planning entirely.
# ARCHER_AI_PLANNING_ROUNDS=1
# Final research answer ceiling, including JSON formatting.
# ARCHER_AI_ANSWER_TOKENS=5000
# Hard token cap per UTC day, across all browser sessions. Interrupted calls retain reservations.
# ARCHER_AI_DAILY_TOKENS=500000
# Optional USD pricing overrides. Official Flash uses reviewed peak ceilings by default.
# ARCHER_AI_INPUT_PRICE=
# ARCHER_AI_OUTPUT_PRICE=
# ARCHER_AI_RUN_USD=0.10
# ARCHER_AI_DAILY_USD=1.00

# Optional card/search provider keys
# TMDB_API_KEY=
# BRAVE_API_KEY=
