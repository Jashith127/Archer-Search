+// Scrolling down folds the search row away (the result types stay); scrolling up, reaching the top
+// or focusing the box brings it back.
+const topBar = $(".top");
+if (topBar) {
+  let last = scrollY;
+  addEventListener("scroll", () => {
+    const y = Math.max(scrollY, 0), dy = y - last;
+    if (y < 8 || dy < -4 || topBar.contains(document.activeElement)) topBar.classList.remove("is-collapsed");
+    else if (dy > 2 && y > 60) topBar.classList.add("is-collapsed");
+    last = y;
+  }, { passive: true });
+  topBar.addEventListener("focusin", () => topBar.classList.remove("is-collapsed"));
+}
